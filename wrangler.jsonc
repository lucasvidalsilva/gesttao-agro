{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestao-agro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestao-agro-db",
      "database_id": "864df2b1-cf84-486a-85b2-32bde6f09ceb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "gestao-agro-documentos"
    }
  ]
}
